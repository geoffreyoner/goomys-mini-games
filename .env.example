# Server
PORT=3000
HOST=0.0.0.0

# Comma-separated allowed origins, or * for development
ALLOWED_ORIGINS=*

# Set true when behind a reverse proxy / tunnel (Cloudflare, nginx) so the
# per-IP room limit uses X-Forwarded-For instead of the proxy's address
TRUST_PROXY=false

# Hard caps on in-memory rooms (total, and per client IP)
MAX_ROOMS=2000
MAX_ROOMS_PER_IP=20

# Node environment
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info